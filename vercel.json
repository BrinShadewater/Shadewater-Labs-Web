{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https:; media-src 'self' https: blob:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/Testing/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Fishmail",
      "destination": "/fishmail",
      "permanent": true
    },
    {
      "source": "/Fishmail/:path*",
      "destination": "/fishmail/:path*",
      "permanent": true
    },
    {
      "source": "/shadewater-seo-report",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/webp-me-daddy",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/inkmaster-studio",
      "destination": "/websites",
      "permanent": true
    },
    {
      "source": "/tech-news",
      "destination": "/toolkit",
      "permanent": true
    },
    {
      "source": "/reviews-notes",
      "destination": "https://brinshadewater.com/reviews-notes",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/fishmail/:path*",
      "destination": "/api/fishmail-demo?route=:path*"
    },
    {
      "source": "/fishmail",
      "destination": "/fishmail/index.html"
    },
    {
      "source": "/fishmail/ocean",
      "destination": "/fishmail/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/projects/brinespace",
      "destination": "/projects/brinespace/index.html"
    },
    {
      "source": "/projects/brinespace/asset-pipeline",
      "destination": "/projects/brinespace/asset-pipeline/index.html"
    },
    {
      "source": "/projects/webp-example",
      "destination": "/projects/webp-example/index.html"
    },
    {
      "source": "/projects/seo-audit-example",
      "destination": "/projects/seo-audit-example/index.html"
    },
    {
      "source": "/projects/futureproof",
      "destination": "/projects/futureproof/index.html"
    },
    {
      "source": "/websites",
      "destination": "/index.html"
    },
    {
      "source": "/toolkit",
      "destination": "/index.html"
    },
    {
      "source": "/research",
      "destination": "/research/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/sl-notebook/privacy",
      "destination": "/sl-notebook/privacy.html"
    },
    {
      "source": "/sl-notebook/terms",
      "destination": "/sl-notebook/terms.html"
    }
  ],
  "outputDirectory": "dist",
  "functions": {
    "api/fishmail-demo.js": { "maxDuration": 30 }
  }
}
